+# Helper de formateo SOLO para CSV (cuando corresponda)
+def format_dt_for_csv(dt_like) -> str:
+    """
+    Formatea timestamps a string para CSV. Mantiene UTC y marca con 'Z'.
+    (Si luego quieres exportar con otra tz, cambia aquí solamente.)
+    """
+    ts = pd.to_datetime(dt_like, errors="coerce", utc=True)
+    if pd.isna(ts):
+        return ""
+    return ts.strftime("%Y-%m-%dT%H:%M:%SZ")
