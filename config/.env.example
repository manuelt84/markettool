PORT=8080
TELEGRA_BOT_TOKEN=7820894723:AAFRp-hzu3aLoZ45rVj--OE9LidPyr4eMd0
FMP_API_KEY=NRnN8Z4yUQOuqvESjIL8Vny97uLk4G9n
WEBHOOK_URL=170.239.86.106
GOOGLE_APPLICATION_CREDENTIALS=trading-firestore.json
PUERTO=8080
WEBHOOK_CERT_PATH=/certs/cert.crt
FMP_PLAN=premium
ECON_CHUNK_DAYS=31
HTTP_TIMEOUT=10
HTTP_RETRIES=3
HTTP_BACKOFF=1.8
# Cache TTL in seconds
CACHE_TTL_CONFIG=600
CACHE_TTL_HISTORICOS=1800
CACHE_MAX_SIZE_HISTORICOS=100

# Cache warmup (all-assets)
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_BLOCKING_STARTUP=false
CACHE_WARMUP_INTERVAL_MINUTES=120
CACHE_WARMUP_MAX_RAM_PERCENT=90
CACHE_WARMUP_CONCURRENCY=8
CACHE_WARMUP_NEWS_ENABLED=false
CACHE_WARMUP_EVENTS_ENABLED=false
CACHE_WARMUP_NEWS_LIMIT=1
CACHE_WARMUP_LEADER_ONLY=false
GCS_ENABLED=true
GCS_BUCKET_NAME=markettool_bucket

# Modo de lectura/escritura cloud. Se cambia solo por .env, no por codigo.
#   gcp      -> Firestore + GCS solamente.
#   vps      -> PostgreSQL/filesystem VPS solamente.
#   gcp_vps  -> GCP principal; VPS queda como respaldo/fallback asincrono.
#   vps_gcp  -> VPS principal; GCP queda como respaldo/fallback asincrono.
#   hybrid   -> alias compatible de gcp_vps.
MARKETTOOL_CLOUD_BACKEND=gcp_vps
# Metadata/Firestore fallback is separate from public storage and historical disk cache.
# In pure gcp mode, leave this false so Firestore/GCP remains the operational source of truth.
MARKETTOOL_METADATA_VPS_FALLBACK_ENABLED=false
# Keep storage routes available for public artifacts (APK/files) without changing metadata source.
MARKETTOOL_PUBLIC_STORAGE=vps
MARKETTOOL_VPS_STORAGE_ROUTES_ENABLED=true
# MARKETTOOL_POSTGRES_DSN=postgresql://markettool:password@170.239.86.106:5432/markettool
# MARKETTOOL_POSTGRES_DSN_FILE=/run/secrets/markettool_postgres_dsn
# MARKETTOOL_POSTGRES_SCHEMA=markettool
# MARKETTOOL_FIRESTORE_REST_ENABLED=true
# MARKETTOOL_VPS_STORAGE_ROOT=/app/storage/markettool-json
# MARKETTOOL_VPS_STORAGE_PUBLIC_BASE_URL=https://api.mtlabsx.com/storage/files
NEWS_CACHE_TTL_SECONDS=300
ECONOMIC_EVENTS_CACHE_TTL=3600
INVESTING_SCRAPING_ENABLED=false

# ========================================================================
# WHATSAPP SUPPORT (UltraMsg, external linked-device service)
# ========================================================================
# Uses the same non-Facebook path as estetica-api.
ULTRAMSG_INSTANCE=
ULTRAMSG_TOKEN=
MARKETTOOL_WHATSAPP_SUPPORT_TO=
MARKETTOOL_WHATSAPP_PUBLIC_NUMBER=56959036525

# ========================================================================
# ⚙️  ARIMA CONFIGURATION (3 modes + Fallback)
# ========================================================================
ARIMA_MODE=standard                       # Options: 'standard' (DEFAULT), 'aggressive', 'unlimited'
ARIMA_TIMEOUT=45                          # Seconds before ARIMA timeout (fallback to simple MA)

# ========================================================================
# PARALLEL ANALYSIS ENGINE (Nivel 3: Máximo paralelismo)
# ========================================================================

# Executor configuration (ThreadPool + ProcessPool)
ANALYSIS_MAX_WORKERS=160                   # ThreadPoolExecutor workers (intermediate: 160)
ANALYSIS_PRED_WORKERS=8                    # ProcessPoolExecutor workers (increased)
ANALYSIS_ANALYSIS_WORKERS=32               # ThreadPoolExecutor workers for general analysis

# Level 1: Multi-Asset Concurrency
PARALLEL_MAX_CONCURRENT_ASSETS=18          # Max simultaneous assets (intermediate: 18)
PARALLEL_BATCH_SIZE_ASSETS=16              # Assets per batch (increased from 8)

# Level 2: Multi-TimeFrame Fanout
PARALLEL_TIMEFRAME_FANOUT=7                # Max concurrent TFs per asset (intermediate: 7)

# Timeouts (seconds)
PARALLEL_GLOBAL_TIMEOUT=300                # 5 minutes total for batch
PARALLEL_TIMEOUT_BATCH=120                 # 2 minutes per batch
PARALLEL_TIMEOUT_ASSET=50                  # 50 seconds per asset (reduced from 60)
PARALLEL_TIMEOUT_TF=10                     # 10 seconds per TF (reduced from 15 - more aggressive)
PARALLEL_TIMEOUT_PREDICTION_ARIMA=15       # Max seconds for individual ARIMA prediction (ParallelAnalysisEngine) - balance optimal
PARALLEL_TIMEOUT_PREDICTION_MC=3           # Max seconds for individual Monte Carlo prediction (ParallelAnalysisEngine)
# ℹ️ NOTA: ARIMA_TIMEOUT es para el sistema legacy (MarketTool.py), PARALLEL_TIMEOUT_PREDICTION_ARIMA es para ParallelAnalysisEngine

# Memory Management
PARALLEL_RAM_PERCENT_LIMIT=80              # Pause analysis if > 80% RAM used

# ========================================================================
# GCP UPLOAD OPTIMIZATION
# ========================================================================
UPLOAD_SEM=120                              # Max concurrent uploads to GCS (increased from 30)

# ========================================================================
# ENTRADAS/SEÑALES - QUALITY OVER QUANTITY
# ========================================================================
ENTRADA_MAX_CANDIDATES=10                  # Max entry points per asset/TF (reduced from 40 for quality)
ENTRADA_MIN_RRR=2.0                        # Minimum Risk/Reward Ratio (increased from 1.5 for better entries)
ENTRADA_ENABLE_LADDERS=false               # Disable ladder entries (adds noise with low confidence)
ENTRADA_ENABLE_RETEST=false                # Disable breakout-retest (less reliable than primary levels)
ENTRADA_ENABLE_RANGE_REVERT=true           # Keep range mean-reversion (useful in ranging markets)

# ========================================================================
# PIPELINE OPTIMIZATION - Phase 2: CSV Consolidation
# ========================================================================
CSV_ENABLE_PRINCIPAL_SECUNDARIA=true       # true=6 CSVs (legacy), false=2-3 global CSVs only
GCP_UPLOAD_MODE=core                       # "core" (optimized) | "extended" | "full" (legacy)
