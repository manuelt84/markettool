# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    MÁQUINA A - ASUS DESKTOP                               ║
# ║                 i7-12700H (14c) | 16GB RAM | 4GB GPU                      ║
# ║                                                                            ║
# ║  Optimization: MAXIMIZE CPU cores (14), be CONSERVATIVE with RAM (16GB)   ║
# ║  Strategy: 1:1 worker-to-core ratio (no oversubscription)                ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

PORT=8080
TELEGRAM_BOT_TOKEN=7820894723:AAFRp-hzu3aLoZ45rVj--OE9LidPyr4eMd0
FMP_API_KEY=NRnN8Z4yUQOuqvESjIL8Vny97uLk4G9n
WEBHOOK_URL=170.239.86.106
GOOGLE_APPLICATION_CREDENTIALS=trading-firestore.json
PUERTO=8080
WEBHOOK_CERT_PATH=/certs/cert.crt
INVESTING_SCRAPING_ENABLED=false
ECON_CHUNK_DAYS=85

# ════════════════════════════════════════════════════════════════════════════
# MACHINE IDENTIFICATION
# ════════════════════════════════════════════════════════════════════════════
# Identifies THIS machine for hardware-optimized worker configuration
MACHINE_TYPE=a

# ════════════════════════════════════════════════════════════════════════════
# CACHE WARMUP (FASE 2) - Machine A Optimization
# ════════════════════════════════════════════════════════════════════════════
# Conservative concurrency due to low RAM per core (16GB / 14 cores = 1.1GB/core)
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_BLOCKING_STARTUP=false
CACHE_WARMUP_INTERVAL_MINUTES=120
CACHE_WARMUP_MAX_RAM_PERCENT=85          # Slightly conservative (85% vs 90%)
CACHE_WARMUP_CONCURRENCY=12               # Conservative for 14-core (2:1 warmup:core)
CACHE_WARMUP_NEWS_ENABLED=false
CACHE_WARMUP_EVENTS_ENABLED=false
CACHE_WARMUP_NEWS_LIMIT=1
CACHE_WARMUP_LEADER_ONLY=false

# ════════════════════════════════════════════════════════════════════════════
# CACHE CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
GCS_ENABLED=true
GCS_BUCKET_NAME=markettool_bucket
GCS_BUCKET=market-tool-historical-data
MARKETTOOL_CLOUD_BACKEND=gcp
MARKETTOOL_POSTGRES_SCHEMA=markettool
MARKETTOOL_VPS_STORAGE_ROOT=/app/storage/markettool-json
MARKETTOOL_VPS_STORAGE_PUBLIC_BASE_URL=https://api.mtlabsx.com/storage/files
CACHE_ENABLE_PRINCIPAL_SECUNDARIA=true
GCP_UPLOAD_MODE=core
NEWS_CACHE_TTL_SECONDS=300
ECONOMIC_EVENTS_CACHE_TTL=3600
CACHE_ENABLED=true
CACHE_STRATEGY=redis_gcs                 # Memory → Redis → GCS (FASE 1)
REDIS_URL=redis://localhost:6379         # LOCAL per machine (not centralized)

# ════════════════════════════════════════════════════════════════════════════
# WORKER CONFIGURATION (FASE 3) - Machine A (i7-12700H: 14 cores, 16GB RAM)
# ════════════════════════════════════════════════════════════════════════════
#
# Machine A Profile:
#   CPU: 14 cores (8 P-cores + 6 E-cores from 12th Gen Intel)
#   RAM: 16GB (1.1GB per core - BOTTLENECK)
#   GPU: 4GB
#
# Strategy: MAXIMIZE CPU, be CONSERVATIVE with Memory
#   - Use all 14 cores for ThreadPool (I/O-bound)
#   - Use 12 cores for ProcessPool (CPU-bound ARIMA)
#   - Monitor memory during warmup (CACHE_WARMUP_MAX_RAM_PERCENT=85)
#
# Tuning Ratios:
#   MAX_WORKERS/CPU = 1.0 (no oversubscription, all cores can work)
#   PRED_WORKERS/CPU = 0.86 (slightly below CPU, CPU-bound safety margin)
#   SEMAPHORE = 85% of MAX_WORKERS (concurrent asset blocks)
#
ANALYSIS_MAX_WORKERS=14                  # 1:1 ratio with CPU (14 cores)
ANALYSIS_PRED_WORKERS=12                 # 86% of CPU (CPU-bound ARIMA)
ANALYSIS_SEMAPHORE=12                    # 85% of MAX_WORKERS (12/14)
ANALYSIS_INNER_WORKERS=4                 # Inner thread pool (unchanged)
ANALYSIS_PRED_USE_PROCESS=true           # Use real ProcessPool (spawn context)

# ════════════════════════════════════════════════════════════════════════════
# PARALLEL ANALYSIS ENGINE (no changes from defaults)
# ════════════════════════════════════════════════════════════════════════════
PARALLEL_MAX_CONCURRENT_ASSETS=18
PARALLEL_BATCH_SIZE_ASSETS=16
PARALLEL_TIMEFRAME_FANOUT=7
PARALLEL_GLOBAL_TIMEOUT=300
PARALLEL_TIMEOUT_BATCH=120
PARALLEL_TIMEOUT_ASSET=50
PARALLEL_TIMEOUT_TF=10
PARALLEL_TIMEOUT_PREDICTION_ARIMA=15
PARALLEL_TIMEOUT_PREDICTION_MC=3
PARALLEL_RAM_PERCENT_LIMIT=80

# ════════════════════════════════════════════════════════════════════════════
# CSV & GCP UPLOAD OPTIMIZATION
# ════════════════════════════════════════════════════════════════════════════
CSV_ENABLE_PRINCIPAL_SECUNDARIA=true
UPLOAD_SEM=120

# ════════════════════════════════════════════════════════════════════════════
# ENTRY POINTS CONFIGURATION (Quality > Quantity)
# ════════════════════════════════════════════════════════════════════════════
ENTRADA_MAX_CANDIDATES=10
ENTRADA_MIN_RRR=2.0
ENTRADA_ENABLE_LADDERS=false
ENTRADA_ENABLE_RETEST=false
ENTRADA_ENABLE_RANGE_REVERT=true

# ════════════════════════════════════════════════════════════════════════════
# HTTP CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════
HTTP_TIMEOUT=10
HTTP_RETRIES=3
HTTP_BACKOFF=1.8

# ════════════════════════════════════════════════════════════════════════════
# CACHE TTL (Time-to-Live) in seconds
# ════════════════════════════════════════════════════════════════════════════
CACHE_TTL_CONFIG=600                     # 10 minutes for config
CACHE_TTL_HISTORICOS=1800                # 30 minutes for historical data
CACHE_MAX_SIZE_HISTORICOS=100            # Max 100 cached symbols

# ════════════════════════════════════════════════════════════════════════════
# ANALYSIS PERSISTENCE
# ════════════════════════════════════════════════════════════════════════════
ANALYSIS_PERSIST_FULL_SERIES=true
ANALYSIS_USE_FULL_HISTORY=false

# ════════════════════════════════════════════════════════════════════════════
# INDICATORS CACHE
# ════════════════════════════════════════════════════════════════════════════
INDICATORS_CACHE_ENABLED=true
INDICATORS_CACHE_TTL_HOURS=24

# ════════════════════════════════════════════════════════════════════════════
# MONITORING / DEBUG
# ════════════════════════════════════════════════════════════════════════════
WARMUP_VERBOSE=0                         # Set to 1 for debug logging during warmup
