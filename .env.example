# ============================================================================
# CACHE CONFIGURATION - Estrategia de caché distribuido
# ============================================================================

# Habilitar/deshabilitar todo el sistema de caché
# Valores: "true" (default), "false"
# CACHE_ENABLED=true

# Estrategia de caché - determina qué capas se utilizan
# Valores disponibles:
#   - "redis_gcs" (RECOMENDADO PRODUCCIÓN)
#     Tier-0: Redis (ultra-rápido, volátil)
#     Tier-1: GCS (persistencia, confiable)
#     Tier-2: Cálculo (fallback)
#
#   - "redis_only" (DESARROLLO/TESTING con Redis)
#     Tier-0: Redis (ultra-rápido, volátil)
#     Tier-1: Cálculo (fallback)
#
#   - "gcs_only" (SIN REDIS, solo persistencia)
#     Tier-0: GCS (persistencia, confiable)
#     Tier-1: Cálculo (fallback)
#
#   - "memory_only" (TESTING, sin persistencia)
#     Tier-0: Memory cache (rápido, volátil)
#     Tier-1: Cálculo (fallback)
#
# CACHE_STRATEGY=redis_gcs

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

# URL de conexión a Redis
# Si CACHE_STRATEGY incluye "redis", esta variable es REQUERIDA
# Ejemplos:
#   - Redis local: redis://localhost:6379
#   - Redis con auth: redis://:password@localhost:6379
#   - Redis Cluster: redis://host:port/0
#   - Formato oficial: redis://[[username][:password]@][host][:port][/db]
#
# REDIS_URL=redis://localhost:6379

# ============================================================================
# GCS CONFIGURATION
# ============================================================================

# Nombre del bucket de GCS donde se almacenan datos históricos
# Si CACHE_STRATEGY incluye "gcs", esta variable es REQUERIDA
# Ejemplo: GCS_BUCKET=market-tool-historical-data
#
# GCS_BUCKET=market-tool-historical-data

# ============================================================================
# EJEMPLOS DE CONFIGURACIÓN
# ============================================================================

# OPCIÓN 1: PRODUCCIÓN (Redis + GCS - Recomendado)
# Descripción: Máximo rendimiento con persistencia
# Ventajas:
#   - Redis cachea resultados recientes (hit rate 80-95%)
#   - GCS persiste datos largo plazo
#   - Fallback automático si una capa no disponible
# Configuración:
#   CACHE_ENABLED=true
#   CACHE_STRATEGY=redis_gcs
#   REDIS_URL=redis://redis-master:6379
#   GCS_BUCKET=market-tool-historical-data

# OPCIÓN 2: DESARROLLO CON REDIS
# Descripción: Testing de Redis sin GCS
# Ventajas:
#   - Rápido, no depende de GCS setup
#   - Ideal para testing local
# Configuración:
#   CACHE_ENABLED=true
#   CACHE_STRATEGY=redis_only
#   REDIS_URL=redis://localhost:6379

# OPCIÓN 3: SIN REDIS (Solo GCS)
# Descripción: Si Redis no disponible pero tienes GCS
# Ventajas:
#   - Persistencia, confiable
#   - Rendimiento intermedio
# Configuración:
#   CACHE_ENABLED=true
#   CACHE_STRATEGY=gcs_only
#   GCS_BUCKET=market-tool-historical-data

# OPCIÓN 4: TESTING (Memory only)
# Descripción: Para tests rápidos sin infraestructura
# Ventajas:
#   - No requiere Redis ni GCS
#   - Muy rápido para tests
# Configuración:
#   CACHE_ENABLED=true
#   CACHE_STRATEGY=memory_only

# OPCIÓN 5: SIN CACHÉ
# Descripción: Debugging, performance testing sin caché
# Configuración:
#   CACHE_ENABLED=false

# ============================================================================
# OTRAS CONFIGURACIONES (OPCIONAL)
# ============================================================================

# Flask environment
# FLASK_ENV=development

# API Key para FMP (Financial Modeling Prep)
# FMP_API_KEY=your_api_key_here

# Google Cloud Project ID (si usas GCS)
# GCP_PROJECT_ID=your-project-id

# ============================================================================
# WHATSAPP SUPPORT (UltraMsg, external linked-device service)
# ============================================================================
# Same non-Facebook integration style used by estetica-api.
# ULTRAMSG_INSTANCE=instanceXXXXX
# ULTRAMSG_TOKEN=your_ultramsg_token
# MARKETTOOL_WHATSAPP_SUPPORT_TO=569XXXXXXXX
# MARKETTOOL_WHATSAPP_PUBLIC_NUMBER=569XXXXXXXX
