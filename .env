INVESTING_SCRAPING_ENABLED=false

# ========================================================================
# ⚙️  REDIS DISTRIBUTED CACHE (Phase 2 Optimization)
# ========================================================================
# Redis as L2 cache for OHLCV historical data
# Benefits: Shared across pods (no per-pod warmup), persists across restarts (no 120s penalty)
# Redis server setup (example): docker run -d -p 6379:6379 redis:7-alpine
# Uncomment and configure REDIS_URL to enable:
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:password@redis-host:6379/0  # With auth
REDIS_URL=

# ========================================================================
# ⚙️  ARIMA CONFIGURATION (100% Standalone - No Legacy)
# ========================================================================
# ℹ️ NOTA: Legacy ARIMA_MODE and ARIMA_TIMEOUT have been removed
#          ParallelAnalysisEngine v2 uses PARALLEL_TIMEOUT_PREDICTION_ARIMA=15s
#          All ARIMA predictions are now pure Python (statsmodels) with fallback to Simple MA

# ========================================================================
# 🚀 PARALLEL ANALYSIS ENGINE v2 (100% Standalone Architecture)
# ========================================================================
# ✅ ESTADO: IMPLEMENTADO Y FUNCIONANDO (Sin dependencias legacy)
# Speedup: 50 activos × 7 TF = 233 min (legacy secuencial) → 2-3 min (paralelo) = 100x
# Ubicación: markettool/application/use_cases/parallel_analysis_v2.py
# Adapter: markettool/application/adapters/legacy_adapter.py

# Executor configuration (ThreadPool + ProcessPool)
ANALYSIS_MAX_WORKERS=32                    # ThreadPoolExecutor workers (reduced: 160->32 for balance)
ANALYSIS_PRED_WORKERS=6                    # ProcessPoolExecutor workers (CPU-bound ARIMA)
ANALYSIS_ANALYSIS_WORKERS=16               # ThreadPoolExecutor workers for general analysis

# Level 1: Multi-Asset Concurrency
PARALLEL_MAX_CONCURRENT_ASSETS=18          # Max simultaneous assets (intermediate: 18)
PARALLEL_BATCH_SIZE_ASSETS=16              # Assets per batch (increased from 8)

# Level 2: Multi-TimeFrame Fanout
PARALLEL_TIMEFRAME_FANOUT=7                # Max concurrent TFs per asset (intermediate: 7)

# Timeouts (seconds) - ✅ NO CONFLICTOS CON LEGACY
PARALLEL_GLOBAL_TIMEOUT=300                # 5 minutes total for batch
PARALLEL_TIMEOUT_BATCH=120                 # 2 minutes per batch
PARALLEL_TIMEOUT_ASSET=50                  # 50 seconds per asset (reduced from 60)
PARALLEL_TIMEOUT_TF=10                     # 10 seconds per TF (MÁS CORTO que legacy con fallback a MA)
PARALLEL_TIMEOUT_PREDICTION_ARIMA=15       # Max seconds for individual ARIMA prediction (with fallback to simple MA)
PARALLEL_TIMEOUT_PREDICTION_MC=3           # Max seconds for individual Monte Carlo prediction

# ✅ ARQUITECTURA DE TIMEOUTS:
# +------------------+
# | Global: 300s     |  (total para batch de 50 activos)
# | +--------+       |
# | | Batch: |120s   |  (por batch de 16 activos)
# | | +----+ |       |
# | | |Asset: |50s   |  (por activo con 7 TF)
# | | | +--+|       |
# | | | |TF: 10s|   |  ← CRITICAL: más corto que legacy (45s)
# | | | | +---+    |  (PERO adapter.predict_arima() tiene fallback a MA en 15s)
# | | | +---------+|
# | | +-----------+|
# | +--------------+
# +------------------+
#
# ✅ NO CONFLICTO porque:
#    1) timeout_per_tf=10s es para TOTAL del TF
#    2) adapter.predict_arima_safe() timeout=15s solo se aplica AL ARIMA
#    3) Si ARIMA se demora > 15s → fallback a Media Móvil (< 1ms)
#    4) MarketTool.py (legacy 45s) solo se usa si llamas directo, NO en ParallelAnalysisEngine

# Memory Management
PARALLEL_RAM_PERCENT_LIMIT=80              # Pause analysis if > 80% RAM used

# ========================================================================
# GCP UPLOAD OPTIMIZATION
# ========================================================================
UPLOAD_SEM=120                              # Max concurrent uploads to GCS (increased from 30)

# ========================================================================
# ENTRADAS/SEÑALES - QUALITY OVER QUANTITY
# ========================================================================
ENTRADA_MAX_CANDIDATES=10                  # Max entry points per asset/TF (reduced from 40 for quality)
ENTRADA_MIN_RRR=2.0                        # Minimum Risk/Reward Ratio (increased from 1.5 for better entries)
ENTRADA_ENABLE_LADDERS=false               # Disable ladder entries (adds noise with low confidence)
ENTRADA_ENABLE_RETEST=false                # Disable breakout-retest (less reliable than primary levels)
ENTRADA_ENABLE_RANGE_REVERT=true           # Keep range mean-reversion (useful in ranging markets)

# ========================================================================
# PIPELINE OPTIMIZATION - Phase 2: CSV Consolidation
# ========================================================================
CSV_ENABLE_PRINCIPAL_SECUNDARIA=true       # true=6 CSVs (legacy), false=2-3 global CSVs only
GCP_UPLOAD_MODE=core                       # "core" (optimized) | "extended" | "full" (legacy)

