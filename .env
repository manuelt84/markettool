FMP_PLAN=premium
ECON_CHUNK_DAYS=85
HTTP_TIMEOUT=10
HTTP_RETRIES=3
HTTP_BACKOFF=1.8
# Cache TTL in seconds
CACHE_TTL_CONFIG=600
CACHE_TTL_HISTORICOS=1800
CACHE_MAX_SIZE_HISTORICOS=100

# ========================================================================
# MACHINE TYPE CONFIGURATION
# ========================================================================
# Set to "a", "b", or "c" to enable hardware-specific optimization
# a = ASUS i7-12700H (14c/16GB)
# b = DELL i9-11900H (8c/32GB)
# c = OMEN Ryzen 7 4800H (8c/32GB)
# Omit or set to "generic" for auto-detection
MACHINE_TYPE=a

# Cache warmup (all-assets) - FASE 2 OPTIMIZED
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_BLOCKING_STARTUP=false
CACHE_WARMUP_INTERVAL_MINUTES=120
CACHE_WARMUP_MAX_RAM_PERCENT=90
CACHE_WARMUP_CONCURRENCY=12
CACHE_WARMUP_NEWS_ENABLED=false
CACHE_WARMUP_EVENTS_ENABLED=false
CACHE_WARMUP_NEWS_LIMIT=1
CACHE_WARMUP_LEADER_ONLY=false
GCS_ENABLED=true
GCS_BUCKET_NAME=markettool_bucket
MARKETTOOL_CLOUD_BACKEND=hybrid
MARKETTOOL_POSTGRES_DSN_FILE=/run/secrets/markettool_postgres_dsn
MARKETTOOL_POSTGRES_SCHEMA=markettool
MARKETTOOL_VPS_STORAGE_ROOT=/app/storage/markettool-json
MARKETTOOL_VPS_STORAGE_PUBLIC_BASE_URL=https://api.mtlabsx.com/storage/files
MARKETTOOL_FIRESTORE_REST_ENABLED=true
MARKETTOOL_VPS_FALLBACK_ENABLED=true
NEWS_CACHE_TTL_SECONDS=300
ECONOMIC_EVENTS_CACHE_TTL=3600
INVESTING_SCRAPING_ENABLED=false

# ========================================================================
# ⚙️  REDIS DISTRIBUTED CACHE (Phase 2 Optimization)
# ========================================================================
# Redis as L2 cache for OHLCV historical data
# Benefits: Shared across pods (no per-pod warmup), persists across restarts (no 120s penalty)
# Redis server setup (example): docker run -d -p 6379:6379 redis:7-alpine
# Uncomment and configure REDIS_URL to enable:
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://:password@redis-host:6379/0  # With auth
REDIS_URL=redis://localhost:6379

# ========================================================================
# ⚙️  ARIMA CONFIGURATION (100% Standalone - No Legacy)
# ========================================================================
# ℹ️ NOTA: Legacy ARIMA_MODE and ARIMA_TIMEOUT have been removed
#          ParallelAnalysisEngine v2 uses PARALLEL_TIMEOUT_PREDICTION_ARIMA=15s
#          All ARIMA predictions are now pure Python (statsmodels) with fallback to Simple MA

# ========================================================================
# 🚀 PARALLEL ANALYSIS ENGINE v2 (100% Standalone Architecture)
# ========================================================================
# ✅ ESTADO: IMPLEMENTADO Y FUNCIONANDO (Sin dependencias legacy)
# Speedup: 50 activos × 7 TF = 233 min (legacy secuencial) → 2-3 min (paralelo) = 100x
# Ubicación: markettool/application/use_cases/parallel_analysis_v2.py
# Adapter: markettool/application/adapters/legacy_adapter.py

# EXECUTOR CONFIGURATION - MACHINE-DEPENDENT (see MACHINE_TYPE above)
# Defaults are for MACHINE_TYPE=a (i7-12700H with 14 cores, 16GB RAM)
# 
# For MACHINE_TYPE=b or c (8-core machines with 32GB RAM):
#   ANALYSIS_MAX_WORKERS=16  (2:1 ratio, safe with more RAM)
#   ANALYSIS_PRED_WORKERS=8  (CPU-bound, 1:1 ratio)
#   CACHE_WARMUP_CONCURRENCY=18 (more RAM allows higher concurrency)
#
# Environment-based: These values can be overridden per .env in each machine folder
ANALYSIS_MAX_WORKERS=14                    # ThreadPoolExecutor (MACHINE_TYPE=a default: 14)
ANALYSIS_PRED_WORKERS=12                   # ProcessPoolExecutor (MACHINE_TYPE=a default: 12)
ANALYSIS_SEMAPHORE=12                      # Asset concurrency limit (85% of MAX_WORKERS)
ANALYSIS_INNER_WORKERS=4                   # Inner indicator calculators
ANALYSIS_PRED_USE_PROCESS=true             # Use ProcessPool (true) vs ThreadPool (false) for ARIMA

# Level 1: Multi-Asset Concurrency
PARALLEL_MAX_CONCURRENT_ASSETS=18          # Max simultaneous assets (intermediate: 18)
PARALLEL_BATCH_SIZE_ASSETS=16              # Assets per batch (increased from 8)

# Level 2: Multi-TimeFrame Fanout
PARALLEL_TIMEFRAME_FANOUT=7                # Max concurrent TFs per asset (intermediate: 7)

# Timeouts (seconds) - ✅ NO CONFLICTOS CON LEGACY
PARALLEL_GLOBAL_TIMEOUT=300                # 5 minutes total for batch
PARALLEL_TIMEOUT_BATCH=120                 # 2 minutes per batch
PARALLEL_TIMEOUT_ASSET=50                  # 50 seconds per asset (reduced from 60)
PARALLEL_TIMEOUT_TF=10                     # 10 seconds per TF (MÁS CORTO que legacy con fallback a MA)
PARALLEL_TIMEOUT_PREDICTION_ARIMA=15       # Max seconds for individual ARIMA prediction (with fallback to simple MA)
PARALLEL_TIMEOUT_PREDICTION_MC=3           # Max seconds for individual Monte Carlo prediction

# ✅ ARQUITECTURA DE TIMEOUTS:
# +------------------+
# | Global: 300s     |  (total para batch de 50 activos)
# | +--------+       |
# | | Batch: |120s   |  (por batch de 16 activos)
# | | +----+ |       |
# | | |Asset: |50s   |  (por activo con 7 TF)
# | | | +--+|       |
# | | | |TF: 10s|   |  ← CRITICAL: más corto que legacy (45s)
# | | | | +---+    |  (PERO adapter.predict_arima() tiene fallback a MA en 15s)
# | | | +---------+|
# | | +-----------+|
# | +--------------+
# +------------------+
#
# ✅ NO CONFLICTO porque:
#    1) timeout_per_tf=10s es para TOTAL del TF
#    2) adapter.predict_arima_safe() timeout=15s solo se aplica AL ARIMA
#    3) Si ARIMA se demora > 15s → fallback a Media Móvil (< 1ms)
#    4) MarketTool.py (legacy 45s) solo se usa si llamas directo, NO en ParallelAnalysisEngine

# Memory Management
PARALLEL_RAM_PERCENT_LIMIT=80              # Pause analysis if > 80% RAM used

# ========================================================================
# GCP UPLOAD OPTIMIZATION
# ========================================================================
UPLOAD_SEM=120                              # Max concurrent uploads to GCS (increased from 30)

# ========================================================================
# ENTRADAS/SEÑALES - QUALITY OVER QUANTITY
# ========================================================================
ENTRADA_MAX_CANDIDATES=10                  # Max entry points per asset/TF (reduced from 40 for quality)
ENTRADA_MIN_RRR=2.0                        # Minimum Risk/Reward Ratio (increased from 1.5 for better entries)
ENTRADA_ENABLE_LADDERS=false               # Disable ladder entries (adds noise with low confidence)
ENTRADA_ENABLE_RETEST=false                # Disable breakout-retest (less reliable than primary levels)
ENTRADA_ENABLE_RANGE_REVERT=true           # Keep range mean-reversion (useful in ranging markets)

# ========================================================================
# PIPELINE OPTIMIZATION - Phase 2: CSV Consolidation
# ========================================================================
CSV_ENABLE_PRINCIPAL_SECUNDARIA=true       # true=6 CSVs (legacy), false=2-3 global CSVs only
GCP_UPLOAD_MODE=extended                   # "core" (optimized) | "extended" | "full" (legacy)

# ========================================================================
# 🚀 ADVANCED CACHE CONFIGURATION (5-Layer System)
# ========================================================================
# Sistema de caché configurable con 5 capas:
# Tier-0: Redis (configurable) - Ultra-rápido <50ms, compartido entre pods
# Tier-1: Memory (siempre activa) - LRU cache en proceso <5ms
# Tier-2: Local Files (siempre activa) - historicos/*.json con freshness check <50ms
# Tier-3: GCS (configurable) - Persistencia en la nube <500ms
# Tier-4: FMP API (siempre activa) - Fallback final 1-5s

# Habilitar/deshabilitar todo el sistema de caché
CACHE_ENABLED=true

# Estrategia de caché (controla qué capas usar)
# Opciones:
#   - redis_gcs   (RECOMENDADO PRODUCCIÓN): Redis + GCS + capas internas
#   - redis_only  (DESARROLLO): Solo Redis + capas internas
#   - gcs_only    (SIN REDIS): Solo GCS + capas internas
#   - memory_only (TESTING): Solo capas internas (Memory + Local)
CACHE_STRATEGY=redis_gcs

# Redis Configuration (si CACHE_STRATEGY incluye "redis")
# REDIS_URL ya está definida arriba (línea 45) - actualízala si es necesario

# GCS Configuration (si CACHE_STRATEGY incluye "gcs")
# GCS_BUCKET_NAME ya está definida arriba (línea 31) - actualízala si es necesario
GCS_BUCKET=market-tool-historical-data

# Full History Mode (mantener serie completa en análisis)
ANALYSIS_PERSIST_FULL_SERIES=true
ANALYSIS_USE_FULL_HISTORY=false

